#!/usr/bin/env zsh
# ================================================================
# Enhanced Zsh Configuration
# ================================================================
# Cross-platform zsh configuration with modern features
# Uses common configurations for consistency with bash

# ================================================================
# DOTFILES CONFIGURATION
# ================================================================

# Dotfiles root directory - always use the ~/.config/dotfiles location
export DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.config/dotfiles}"

# Vi mode settings (matching bash configuration)
export KEYTIMEOUT=1
bindkey -v
bindkey -M viins 'jj' vi-cmd-mode
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line

# Load platform detection and common configurations
source "$DOTFILES_ROOT/common/platform.sh"
source "$DOTFILES_ROOT/common/cached-eval.sh"
source "$DOTFILES_ROOT/common/exports.sh"
source "$DOTFILES_ROOT/common/paths.sh"
source "$DOTFILES_ROOT/common/aliases.sh"
source "$DOTFILES_ROOT/common/functions.sh"
source "$DOTFILES_ROOT/common/tools.sh"

# ================================================================
# ZSH-SPECIFIC CONFIGURATION
# ================================================================

# ================================================================
# ZSH OPTIONS AND KEYBINDINGS
# ================================================================

# Additional zsh options for better UX
setopt AUTO_CD              # Change directory without typing cd
unsetopt CORRECT            # Disable command correction (prevents "correct X to Y?" prompts)
unsetopt CORRECT_ALL        # Disable argument correction
setopt EXTENDED_GLOB        # Extended globbing
setopt GLOB_DOTS            # Include dotfiles in globbing
setopt NOMATCH              # Print error if pattern has no matches
setopt NOTIFY               # Report background job status immediately
setopt PROMPT_SUBST         # Allow parameter expansion in prompts

# History options (enhanced from common exports.sh)
setopt EXTENDED_HISTORY     # Record timestamp and duration
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
# setopt HIST_REDUCE_BLANKS  # Disabled to preserve multiline command formatting
setopt HIST_SAVE_NO_DUPS
setopt HIST_VERIFY          # Don't execute immediately upon expansion
setopt SHARE_HISTORY        # Share history between sessions
setopt INC_APPEND_HISTORY   # Append to history file immediately

# Completion options
setopt AUTO_LIST            # List choices on ambiguous completion
setopt AUTO_MENU            # Show completion menu on successive tab press
setopt ALWAYS_TO_END        # Move cursor to end if word had one match
setopt COMPLETE_IN_WORD     # Complete from both ends of word
setopt FLOW_CONTROL         # Disable start/stop characters
unsetopt MENU_COMPLETE      # Don't autoselect the first completion entry

# ================================================================
# ZSH COMPLETION SYSTEM
# ================================================================

# Every completion directory (Homebrew, $DOTFILES_ROOT/zsh/completions,
# ~/.zfunc, ~/.docker/completions, ~/.grok/completions/zsh, …) is put on fpath
# by common/paths.sh:setup_fpath, which runs before the single compinit in
# common/completions.sh. Add new directories there, not here: an fpath entry
# added after compinit is invisible until a second (slow) compinit.

# Completion styling
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}No matches found%f'

# Initialize the completion system BEFORE any compdef calls.
#
# common/completions.sh (sourced via common/tools.sh at the top of this file)
# already initializes it — it has to, because it registers completions and would
# otherwise run against a shell with no compdef/complete. So this is normally a
# no-op and exists as the fallback for a zshrc loaded without that chain. Each
# half is guarded because compinit is among the slowest steps in zsh startup and
# there is nothing to gain from running it twice.
typeset -f compdef >/dev/null 2>&1 || { autoload -Uz compinit && compinit -i; }
typeset -f complete >/dev/null 2>&1 || { autoload -U +X bashcompinit && bashcompinit; }

# ================================================================
# LEGACY FUNCTION LOADING
# ================================================================

# Load legacy functions if they exist
[[ -f "$HOME/.functions.zsh" ]] && source "$HOME/.functions.zsh"

# Re-bind vi mode keys after autosuggestions loads (plugins are loaded by
# common/tools.sh, before this file reaches this point)
if typeset -f _zsh_autosuggest_bind_widgets &>/dev/null; then
    bindkey -M viins 'jj' vi-cmd-mode
    bindkey -M viins '^A' beginning-of-line
    bindkey -M viins '^E' end-of-line
fi


# ================================================================
# PROMPT SETUP - STARSHIP
# ================================================================

# Initialize Starship prompt (unified for bash and zsh)
# Init output is cached by common/cached-eval.sh (regenerated when the binary or
# its config changes); DOTFILES_NO_EVAL_CACHE=1 restores the plain eval.
if command -v starship >/dev/null 2>&1; then
    _cached_eval starship starship init zsh
else
    # Fallback: Auto-install Starship if not available
    if [[ -t 1 ]]; then
        echo "🌟 Setting up Starship prompt..."
        if command -v brew >/dev/null 2>&1; then
            brew install starship 2>/dev/null && _cached_eval starship starship init zsh
        fi
    fi
fi

# ================================================================
# DIRENV SETUP
# ================================================================

# Initialize direnv for automatic environment management
if command -v direnv >/dev/null 2>&1; then
    _cached_eval direnv direnv hook zsh
fi

# ================================================================
# ATUIN SETUP
# ================================================================

# Initialize atuin for shell history sync and search. Its init output depends
# on config.toml (key bindings), so the cache is keyed on that file too.
if command -v atuin >/dev/null 2>&1; then
    _cached_eval --dep "${ATUIN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/atuin}/config.toml" \
        atuin atuin init zsh
elif [[ -f "$HOME/.atuin/bin/atuin" ]]; then
    export PATH="$HOME/.atuin/bin:$PATH"
    _cached_eval --dep "${ATUIN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/atuin}/config.toml" \
        atuin atuin init zsh
fi


# ================================================================
# USER CUSTOMIZATIONS
# ================================================================

# Machine-local overrides (dotfiles.local/, secrets, ~/.zshrc.local) are
# loaded by common/local.sh, the last line of this file.

# Note: WezTerm theme is defined in common/exports.sh

# macOS-specific tools and configurations
if is_macos; then
    # Turso CLI
    if [[ -d "$HOME/.turso" ]]; then
        append_path "$HOME/.turso"
    fi

    # Unlock Keychain on SSH login
    if [ -n "$SSH_CONNECTION" ] && [ -z "$KEYCHAIN_UNLOCKED" ]; then
        security unlock-keychain ~/Library/Keychains/login.keychain-db 2>/dev/null
        export KEYCHAIN_UNLOCKED=true
    fi
fi
ulimit -n 65536

# ================================================================
# FINAL PATH CLEANUP
# ================================================================

# Single owner: common/paths.sh:finalize_path — dedupe, drop Nix and
# wrong-platform paths, macOS Homebrew ordering, debug line, export. Runs
# after all shell initialization and before local.sh, so
# dotfiles.local/paths.sh entries are neither reordered nor removed.
finalize_path

# Note: kubectl aliases are defined in common/aliases.sh
# Note: kubectl completions are loaded by common/lazy-completions.sh
# Note: KUBECONFIG is defined in common/exports.sh
# Note: Node.js runtime is managed by mise (configured in common/tools.sh)

# Installer-added blocks below. Installers that append `fpath=(… $fpath)` plus
# `compinit` here: move the directory into common/paths.sh:setup_fpath (guarded
# with [[ -d ]]) and delete the compinit — each extra compinit costs ~150ms and
# rewrites ~/.zcompdump. rfmedia (~/.zfunc), Docker Desktop
# (~/.docker/completions) and grok (~/.grok/completions/zsh) already live there.

# pnpm 11+ globals live in $PNPM_HOME/bin. common/paths.sh adds the same dirs
# when they exist; this block keeps a current-session PATH even before a
# reload, and uses $HOME so the shared zshrc is not machine-specific.
# pnpm
export PNPM_HOME="${HOME}/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# Added by Antigravity
export PATH="${HOME}/.antigravity/antigravity/bin:$PATH"

# Branchlet setup: added on 2026-03-01
_branchlet() {
  local -a commands
  commands=(
    'create:Create a new worktree'
    'list:List all worktrees'
    'delete:Delete a worktree'
    'settings:Manage configuration'
  )
  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --version)'{-v,--version}'[Show version]' \
    '(-m --mode)'{-m,--mode}'[Set mode]:mode:(menu create list delete settings)' \
    '--from-wrapper[Called from shell wrapper]' \
    '1:command:->command'
  case "$state" in
    command)
      _describe -t commands 'branchlet commands' commands
      ;;
  esac
}
compdef _branchlet branchlet
branchlet() {
  if [ $# -eq 0 ]; then
    local dir=$(FORCE_COLOR=3 command branchlet --from-wrapper)
    if [ -n "$dir" ]; then
      builtin cd "$dir" && echo "Branchlet: Navigated to $(pwd)"
    fi
  else
    command branchlet "$@"
  fi
}
# End Branchlet setup


# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
# fpath entry lives in common/paths.sh:setup_fpath.
# <<< grok installer <<<

# Machine-local overrides, secrets and ~/.zshrc.local. MUST stay the last line.
source "$DOTFILES_ROOT/common/local.sh"
