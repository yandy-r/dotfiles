  "agent": {
    "inline_assistant_model": {
      "provider": "Tokenhop",
      "model": "cc/claude-sonnet-5-5",
      "enable_thinking": false,
    },
    "tool_permissions": {
      "tools": {
        "mcp:mcp-server-github:search_code": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "profiles": {},
    "sandbox_permissions": {
      "allow_fs_write_all": true,
      "allow_all_hosts": true,
    },
    "default_model": {
      "provider": "Tokenhop",
      "model": "Frontier-Lite",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "Tokenhop",
        "model": "Frontier-Lite",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "cc/claude-opus-5-5",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "Lite",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "Suggest",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "kimi/k3",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "glm/glm-5.3",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "Frontier",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "glm/glm-5.3-flash",
        "enable_thinking": false,
      },
      {
        "provider": "Tokenhop",
        "model": "Frontier-Ultra",
        "enable_thinking": false,
      },
    ],
    "commit_message_model": {
      "provider": "Tokenhop",
      "model": "cx/gpt-6-luna(minimal)",
    },
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      "prompt_format": "qwen",
      "prediction_debounce": 150,
      "max_output_tokens": 128,
      "model": "gcli/grok-4.7-build-fast(minimal)",
      "api_url": "https://tokenhop.example-tailnet.ts.net/v1/completions",
    },
  },
  "ssh_connections": [
    {
      "host": "ubsrv",
      "args": [],
      "projects": [
        {
          "paths": ["/home/yandy/.config/dotfiles"],
        },
        {
          "paths": ["/home/yandy/Projects/github.com/yandy-r/private-apps"],
        },
      ],
    },
    {
      "host": "ubdevsrv",
      "args": [],
      "projects": [
        {
          "paths": ["/home/yandy/.config/dotfiles/./"],
        },
        {
          "paths": ["/home/yandy/Projects/github.com/yandy-r/tokenhop/./"],
        },
        {
          "paths": ["/home/yandy/Projects/github.com/yandy-r/praxrr/./"],
        },
      ],
    },
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "load_direnv": "direct",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_weight": 500,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "use_autoclose": true,
  "show_completions_on_input": true,
  "git_panel": {
    "button": true,
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "sticky_scroll": {
    "enabled": true,
  },
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
    "max_width_columns": 120,
  },
  "format_on_save": "on",
  "formatter": "auto",
  "cursor_shape": "bar",
  "file_types": {
    "shellscript": ["zshrc"],
    "javascript": ["*.js"],
    "nginx": ["default"],
    "graphql": ["*.prisma"],
    "mdx": ["*.mdx"],
    "typescript": ["*.ts"],
    "yaml": ["*.yml", "*.yaml"],
    "javascriptreact": ["*.jsx"],
    "plaintext": ["*.txt"],
    "markdown": ["*.md"],
  },
  "colorize_brackets": true,
  "auto_indent_on_paste": true,
  "linked_edits": true,
  "use_on_type_format": false,
  "show_edit_predictions": true,
  "wrap_guides": [100, 120],
  "hard_tabs": false,
  "tab_size": 2,
  "base_keymap": "VSCode",
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
  },
  "scrollbar": {
    "show": "auto",
  },
  "cursor_blink": false,
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "preferred_line_length": 120,
  "soft_wrap": "none",
  "show_whitespaces": "boundary",
  "terminal": {
    "default_height": 1300.0,
    "font_size": 15.0,
    "font_family": "JetBrainsMono Nerd Font",
    "max_scroll_history_lines": 100000,
    "copy_on_select": true,
    "working_directory": "current_project_directory",
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
  },
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "auto_fold_dirs": false,
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "auto_update": true,
  "auto_install_extensions": {
    "ansible": true,
    "biome": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "env": true,
    "git-firefly": true,
    "gosum": true,
    "html": true,
    "ini": true,
    "jinja2": true,
    "log": true,
    "lua": true,
    "make": true,
    "markdown-oxide": true,
    "mcp-server-github": true,
    "mermaid": true,
    "rainbow-csv": true,
    "sql": true,
    "svelte": true,
    "swift": true,
    "terraform": true,
    "toml": true,
    "xml": true,
    "zig": true,
  },
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-", "--line-length", "120"],
        },
      },
      "tab_size": 4,
    },
    "TypeScript": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "JavaScript": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "JSON": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "YAML": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Go": {
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": true,
      "formatter": {
        "external": {
          "command": "goimports",
        },
      },
    },
    "Rust": {
      "format_on_save": "on",
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "rustfmt",
          "arguments": ["--edition", "2021"],
        },
      },
    },
    "Markdown": {
      "soft_wrap": "none",
      "preferred_line_length": 120,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}",
            "--parser",
            "markdown",
            "--prose-wrap",
            "always",
            "--print-width",
            "100",
          ],
        },
      },
    },
    "Lua": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["-"],
        },
      },
    },
    "TOML": {
      "format_on_save": "on",
      "tab_size": 2,
    },
    "Shell Script": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "2", "-ci", "-bn"],
        },
      },
    },
    "HTML": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "CSS": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
        "inlayHints": {
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
          },
        },
      },
    },
  },
}
