# shellcheck shell=sh
# ================================================================
# Bash Profile Loader
# ================================================================
# This file is symlinked to ~/.profile and loads the main bash_profile
# for bash login shells. NVM and Cargo are handled by the modern config system.
# It is also read by /bin/sh (dash) login shells, so it must stay POSIX sh:
# no [[ ]], no `source`, and every sourced file guarded by an existence check.

# Prevent circular loading. Per-process (PID) guard, never exported: nested
# login shells load their own config, re-sourcing stays a no-op. POSIX only:
# this file is also read by /bin/sh login shells.
[ "${DOTFILES_PROFILE_LOADED:-}" = "$$" ] && return 0
unset DOTFILES_PROFILE_LOADED
DOTFILES_PROFILE_LOADED=$$

# Chain into .bash_profile only under bash: it is bash-only (and dash, the
# usual /bin/sh, would choke on it). POSIX test and `.` so sh can parse this.
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bash_profile" ]; then
    . "$HOME/.bash_profile"
fi
# POSIX only: this file is also read by /bin/sh login shells. Skip when the
# file is missing or cargo's bin dir is already on PATH (setup_rust_env or a
# prior shell did it).
if [ -f "$HOME/.cargo/env" ]; then
    case ":$PATH:" in
    *":$HOME/.cargo/bin:"*) ;;
    *) . "$HOME/.cargo/env" ;;
    esac
fi

# atuin's env script is optional: skip it on hosts without atuin installed.
if [ -f "$HOME/.atuin/bin/env" ]; then
    . "$HOME/.atuin/bin/env"
fi

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/yandy/.lmstudio/bin"
