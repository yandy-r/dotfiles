#!/usr/bin/env bash
# ================================================================
# Enhanced Bash Configuration
# ================================================================
# Cross-platform bash configuration with modern features
# Aligned with zsh configuration for consistency

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

# Prevent infinite loading loops
if [[ -n "${DOTFILES_BASHRC_LOADED}" ]]; then
	return 0
fi
export DOTFILES_BASHRC_LOADED=1

# Ensure we have a minimal PATH (critical for system stability)
if [[ -z "$PATH" ]]; then
	export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin"
fi

# ================================================================
# DOTFILES CONFIGURATION
# ================================================================

# Dotfiles root directory - always use the ~/.config/dotfiles location
export DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.config/dotfiles}"

# Load platform detection and common configurations
source "$DOTFILES_ROOT/common/platform.sh"
source "$DOTFILES_ROOT/common/cached-eval.sh"
source "$DOTFILES_ROOT/common/exports.sh"
source "$DOTFILES_ROOT/common/paths.sh"
source "$DOTFILES_ROOT/common/aliases.sh"
source "$DOTFILES_ROOT/common/functions.sh"

# Source at top level: bash-completion 2.1–2.8 declare global arrays here.
# The candidate paths have one owner in common/paths.sh.
if ! shopt -oq posix && [[ -z "${BASH_COMPLETION_VERSINFO:-}" ]]; then
	if _dotf_completion_file="$(_dotf_bash_completion_file)"; then
		# shellcheck source=/dev/null
		source "$_dotf_completion_file"
	fi
	unset _dotf_completion_file
fi

source "$DOTFILES_ROOT/common/tools.sh"

# ================================================================
# BASH-SPECIFIC SETTINGS
# ================================================================

# Shell options
shopt -s histappend   # Append to history file
shopt -s checkwinsize # Update LINES and COLUMNS after each command
shopt -s cdspell      # Correct minor spelling errors in cd commands
shopt -s dotglob      # Include dotfiles in pathname expansion
shopt -s extglob      # Extended pattern matching
shopt -s nocaseglob   # Case-insensitive globbing

# Modern bash features (bash 4.0+)
if [[ "${BASH_VERSION%%.*}" -ge 4 ]]; then
	shopt -s globstar # Enable ** globbing
	shopt -s dirspell # Correct minor spelling errors in directory names
	shopt -s autocd   # Change directory without typing cd
else
	# Warn about old bash version
	if [[ -t 1 ]]; then # Only show warning in interactive shells
		echo "⚠️  Using bash ${BASH_VERSION}. For best experience, install modern bash:"
		echo "   brew install bash && chsh -s /opt/homebrew/bin/bash"
	fi
fi

# Bind keys for better navigation (similar to zsh)
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set show-all-if-unmodified on'
bind 'set colored-stats on'
bind 'set visible-stats on'
bind 'set mark-symlinked-directories on'
bind 'set colored-completion-prefix on'
bind 'set menu-complete-display-prefix on'

# Vi mode keybindings (to match zsh vi mode)
set -o vi
bind -m vi-insert '"jj": vi-movement-mode'

# History search with up/down arrows
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# ================================================================
# PROMPT SETUP - STARSHIP
# ================================================================

# Initialize Starship prompt (unified for bash and zsh). `starship init bash`
# only prints `eval "$(starship init bash --print-full-init)"`, so the full init
# is what gets cached (common/cached-eval.sh; DOTFILES_NO_EVAL_CACHE=1 bypasses).
if command -v starship >/dev/null 2>&1; then
	_cached_eval starship starship init bash --print-full-init
else
	# Fallback: Auto-install Starship if not available
	if [[ -t 1 ]]; then
		echo "🌟 Setting up Starship prompt..."
		if command -v brew >/dev/null 2>&1; then
			brew install starship 2>/dev/null && _cached_eval starship starship init bash --print-full-init
		else
			# Use custom prompt if Starship can't be installed
			source "$DOTFILES_ROOT/bash/prompt.sh" 2>/dev/null || {
				PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
			}
		fi
	else
		# Non-interactive: use custom prompt
		source "$DOTFILES_ROOT/bash/prompt.sh" 2>/dev/null || {
			PS1='\u@\h:\w\$ '
		}
	fi
fi

# ================================================================
# LEGACY COMPATIBILITY
# ================================================================

# Load legacy aliases if they exist
[[ -f ~/.aliases ]] && source ~/.aliases
[[ -f ~/.bash_aliases ]] && source ~/.bash_aliases

# Legacy profile loading - DISABLED to prevent circular sourcing
# Note: ~/.profile sources ~/.bash_profile which sources ~/.bashrc creating a loop
# [[ -f ~/.profile ]] && source ~/.profile

# ================================================================
# DIRENV SETUP
# ================================================================

# Initialize direnv for automatic environment management
if command -v direnv >/dev/null 2>&1; then
	_cached_eval direnv direnv hook bash
fi

# ================================================================
# ATUIN SETUP
# ================================================================

# Initialize atuin for shell history sync and search. Its init output depends
# on config.toml (key bindings), so the cache is keyed on that file too.
if command -v atuin >/dev/null 2>&1; then
	_cached_eval --dep "${ATUIN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/atuin}/config.toml" \
		atuin atuin init bash
elif [[ -f "$HOME/.atuin/bin/atuin" ]]; then
	export PATH="$HOME/.atuin/bin:$PATH"
	_cached_eval --dep "${ATUIN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/atuin}/config.toml" \
		atuin atuin init bash
fi

# ================================================================
# FINAL PATH CLEANUP
# ================================================================

# Single owner: common/paths.sh:finalize_path — dedupe, drop Nix and
# wrong-platform paths, macOS Homebrew ordering, debug line, export. Same
# point as zshrc (after atuin, before local.sh), so dotfiles.local/paths.sh
# entries are neither reordered nor removed.
finalize_path

# ================================================================
# POST-LOAD CUSTOMIZATIONS
# ================================================================

# Machine-local overrides (dotfiles.local/, secrets, ~/.bashrc.local) are
# loaded by common/local.sh, the last line of this file.

# Set terminal title (similar to zsh behavior). The single source of the title
# for both Starship and the bash/prompt.sh fallback. A function, so $PWD is read
# at every prompt and never parsed as shell code.
case "$TERM" in
xterm* | rxvt* | screen*)
	_dotf_set_title() {
		printf '\033]0;%s@%s: %s\007' "$USER" "$HOSTNAME" "$PWD"
	}
	# PROMPT_COMMAND is a string, or an array (bash >= 5.1 when the user made
	# it one). Strip a trailing ';' first (zoxide leaves "__zoxide_hook;"):
	# ';;' in PROMPT_COMMAND is a syntax error at every prompt. Bash 3.2-safe.
	# shellcheck disable=SC2178,SC2128
	if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
		PROMPT_COMMAND+=(_dotf_set_title)
	else
		_pc="${PROMPT_COMMAND:-}"
		_pc="${_pc%"${_pc##*[!; ]}"}"
		PROMPT_COMMAND="${_pc:+$_pc; }_dotf_set_title"
		unset -v _pc
	fi
	;;
esac

# Note: kubectl aliases are defined in common/aliases.sh
# Note: WEZTERM_THEME is defined in common/exports.sh
# Note: KUBECONFIG is defined in common/exports.sh
# Note: zoxide uses 'z' command (not replacing cd) - initialized in tools.sh

# opencode
export PATH=/home/yandy/.opencode/bin:$PATH

# Machine-local overrides, secrets and ~/.bashrc.local. MUST stay the last line.
source "$DOTFILES_ROOT/common/local.sh"
