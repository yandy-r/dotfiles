# shellcheck shell=bash
# ================================================================
# Cross-Platform Bash Profile
# ================================================================
# This file is loaded for login shells. It should be kept minimal
# and delegate to the modern configuration system.

# Prevent circular loading
[[ -n "$DOTFILES_BASH_PROFILE_LOADED" ]] && return 0
export DOTFILES_BASH_PROFILE_LOADED=1

# Installer-added PATH lines stay here, BEFORE ~/.bashrc: bashrc returns early in
# non-interactive shells (so `bash -l -c` still needs them), and for interactive
# login shells bashrc's final common/local.sh must run after them so
# dotfiles.local/paths.sh entries stay first on PATH.

# Added by CodeRabbit CLI installer
export PATH="/home/yandy/.local/bin:$PATH"

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/yandy/.lmstudio/bin"
# End of LM Studio CLI section

# Source the main bashrc configuration
if [[ -f ~/.bashrc ]]; then
    source ~/.bashrc
fi

# Legacy dotfiles support (optional). These run after ~/.bashrc, and therefore
# after common/local.sh, so they still override both.
for file in ~/.{path,extra}; do
    [[ -r "$file" ]] && source "$file"
done
unset file

# Cargo environment (if Rust is installed)
if [[ -f "$HOME/.cargo/env" ]]; then
    source "$HOME/.cargo/env"
fi

# direnv: bash/bashrc normally installs the hook, but it returns early when
# DOTFILES_BASHRC_LOADED is inherited from a parent shell (e.g. `bash -l` from
# an interactive bash), leaving this login shell without one. Install it here
# only when it is still missing, so a normal login never hooks twice.
if [[ $- == *i* ]] && command -v direnv >/dev/null 2>&1 &&
    [[ "${PROMPT_COMMAND[*]:-}" != *_direnv_hook* ]]; then
    eval "$(direnv hook bash)"
fi

if [[ -f "$HOME/.atuin/bin/env" ]]; then
    source "$HOME/.atuin/bin/env"
fi

