# shellcheck shell=bash
# ================================================================
# Cross-Platform Bash Profile
# ================================================================
# This file is loaded for login shells. It should be kept minimal
# and delegate to the modern configuration system.

# Prevent circular loading. Per-process (PID) guard, never exported: nested
# `bash -l` shells load their own login config, re-sourcing stays a no-op.
if [[ "${DOTFILES_BASH_PROFILE_LOADED:-}" == "$$" ]]; then
    return 0
fi
unset DOTFILES_BASH_PROFILE_LOADED
DOTFILES_BASH_PROFILE_LOADED=$$

# Non-interactive login shells (e.g. `bash -l -c …`) never read ~/.bashrc:
# bashrc returns early for them, so they would end up with no DOTFILES_OS and
# no PATH setup. Mirror zsh/zprofile: source platform and paths (the common
# subset that is safe outside an interactive shell) before anything else.
# Interactive login shells get the full config via ~/.bashrc below.
if [[ $- != *i* ]]; then
    DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.config/dotfiles}"
    [[ -f "$DOTFILES_ROOT/common/platform.sh" ]] &&
        source "$DOTFILES_ROOT/common/platform.sh"
    [[ -f "$DOTFILES_ROOT/common/paths.sh" ]] &&
        source "$DOTFILES_ROOT/common/paths.sh"
fi

# Added by CodeRabbit CLI installer
export PATH="/home/yandy/.local/bin:$PATH"

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/yandy/.lmstudio/bin"
# End of LM Studio CLI section

# Source the main bashrc configuration
if [[ -f ~/.bashrc ]]; then
    source ~/.bashrc
fi

# Legacy dotfiles support (optional). These run after ~/.bashrc, and therefore
# after common/local.sh, so they still override both.
for file in ~/.{path,extra}; do
    [[ -r "$file" ]] && source "$file"
done
unset file

# direnv: bash/bashrc installs the hook for interactive shells. Only a shell
# where ~/.bashrc was unreadable or failed early can reach here interactive
# without one; install it then, so a normal login never hooks twice.
if [[ $- == *i* ]] && command -v direnv >/dev/null 2>&1 &&
    [[ "${PROMPT_COMMAND[*]:-}" != *_direnv_hook* ]]; then
    eval "$(direnv hook bash)"
fi

if [[ -f "$HOME/.atuin/bin/env" ]]; then
    source "$HOME/.atuin/bin/env"
fi

