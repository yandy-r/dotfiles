#!/usr/bin/env bash
# ================================================================
# .envrc Generator
# ================================================================
# Creates a .envrc file in the current directory that loads .env
# (non-secret local settings) and provides a template for project-specific
# environment setup. Secrets stay in 1Password: it also scaffolds
# op/local.env, a committed template of op:// references that
# `with-secrets -- <cmd>` (or `op run --env-file=op/local.env -- <cmd>`)
# resolves at run time. Secret values are never written to disk.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() {
    echo -e "${GREEN}[INFO]${NC} $*"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

error() {
    echo -e "${RED}[ERROR]${NC} $*"
}

success() {
    echo -e "${BLUE}[SUCCESS]${NC} $*"
}

# Get project name from directory or allow override
PROJECT_NAME="${1:-$(basename "$PWD")}"
ENVRC_FILE=".envrc"
ENV_FILE=".env"
ENV_EXAMPLE_FILE=".env.example"
OP_DIR="op"
OP_TEMPLATE_FILE="$OP_DIR/local.env"

# Check if .envrc already exists
if [[ -f "$ENVRC_FILE" ]]; then
    warn ".envrc already exists in this directory"
    read -p "Do you want to overwrite it? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        info "Keeping existing .envrc file"
        exit 0
    fi
fi

# Create .envrc file
info "Creating .envrc for project: $PROJECT_NAME"

cat > "$ENVRC_FILE" << 'EOF'
#!/usr/bin/env bash
# ==================================================
# PROJECT_NAME - direnv configuration
# ==================================================
# Automatically loads environment variables when entering directory
# Run 'direnv allow' after creating/modifying this file

# Load .env (non-secret local settings) if it exists
if [[ -f .env ]]; then
    set -a  # Mark all variables for export
    source .env
    set +a  # Stop marking for export
fi

# ================================================================
# Secrets (1Password)
# ================================================================
# Secrets live in 1Password. op/local.env (committed) lists op:// references
# only; run commands that need them through the loader:
#     with-secrets -- npm run dev           # op/local.env
#     with-secrets -e prod -- npm run migrate   # op/prod.env
# or directly: op run --env-file=op/local.env -- npm run dev
#
# Opt-in: export the resolved secrets into this shell on cd (slower, may
# prompt the 1Password app; values then live in the shell environment):
# if has op && [[ -f op/local.env ]]; then
#     dotenv <(op inject --in-file op/local.env)
# fi

# ================================================================
# Project-specific environment configuration
# ================================================================

# Uncomment and customize as needed:

# Add project bin directory to PATH
# export PATH="$PWD/bin:$PATH"

# Add node_modules/.bin to PATH for npm/yarn projects
# export PATH="$PWD/node_modules/.bin:$PATH"

# Set project root
# export PROJECT_ROOT="$PWD"

# Language/runtime version management
# Example for Node.js with nvm:
# use node 20.0.0

# Example for Python with virtualenv:
# Option 1: Use direnv's layout python (recommended - auto-manages venv)
# layout python python3
#
# Option 2: Use existing virtualenv
# export VIRTUAL_ENV="$PWD/.venv"
# export PATH="$VIRTUAL_ENV/bin:$PATH"
#
# Option 3: Specific Python version
# layout python python3.11

# Example for Ruby with rbenv:
# use ruby 3.2.0

# Example for Go:
# export GOPATH="$PWD/.go"
# export PATH="$GOPATH/bin:$PATH"

# Cloud provider configurations
# export AWS_PROFILE="project-dev"
# export GCP_PROJECT="my-project"
# export AZURE_SUBSCRIPTION_ID="..."

# Development tool configurations
# export DOCKER_BUILDKIT=1
# export COMPOSE_PROJECT_NAME="project-name"

# Custom aliases for this project (use 'watch_file' to reload on changes)
# watch_file package.json
# watch_file Makefile

# ================================================================
# Helper functions
# ================================================================

# Example: Verify required tools are installed
# check_dependencies() {
#     local deps=("node" "docker" "kubectl")
#     for dep in "${deps[@]}"; do
#         if ! command -v "$dep" &> /dev/null; then
#             echo "ERROR: Required dependency '$dep' not found"
#             return 1
#         fi
#     done
# }

# Uncomment to run checks on load
# check_dependencies

# ================================================================
# Load completion
# ================================================================

# Optional: Print loaded environment info
# echo "✓ Environment loaded for: PROJECT_NAME"
# echo "  Project root: $PWD"
# echo "  PATH: ${PATH%%:*}:..."  # Show first PATH entry
EOF

# Replace PROJECT_NAME placeholder
sed -i.bak "s/PROJECT_NAME/$PROJECT_NAME/g" "$ENVRC_FILE" && rm "${ENVRC_FILE}.bak"

success ".envrc created successfully!"
echo

# Create .env.example if it doesn't exist
if [[ ! -f "$ENV_EXAMPLE_FILE" ]]; then
    info "Creating .env.example template..."
    cat > "$ENV_EXAMPLE_FILE" << EOF
# ==================================================
# $PROJECT_NAME - Environment Variables
# ==================================================
# Copy this file to .env and fill in the values
# .env is gitignored and should never be committed

# Application settings
# APP_ENV=development
# APP_DEBUG=true
# LOG_LEVEL=info

# Database configuration
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=${PROJECT_NAME}_dev
# DB_USER=postgres
# DB_PASSWORD=

# API keys and secrets do NOT go here: add them as op:// references in
# op/local.env and run commands with: with-secrets -- <cmd>

# External services
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://localhost:5672

# Feature flags
# ENABLE_FEATURE_X=false
# ENABLE_METRICS=true
EOF
    success ".env.example created!"
fi

# Create .env if it doesn't exist (copy from .env.example)
if [[ ! -f "$ENV_FILE" ]] && [[ -f "$ENV_EXAMPLE_FILE" ]]; then
    info "Creating .env from .env.example..."
    cp "$ENV_EXAMPLE_FILE" "$ENV_FILE"
    success ".env created from template!"
    warn "Remember to fill in actual values in .env"
fi

# Create the 1Password reference template if it doesn't exist
if [[ ! -f "$OP_TEMPLATE_FILE" ]]; then
    info "Creating $OP_TEMPLATE_FILE (1Password op:// references)..."
    mkdir -p "$OP_DIR"
    cat > "$OP_TEMPLATE_FILE" << EOF
# ==================================================
# $PROJECT_NAME - 1Password secret references (local)
# ==================================================
# Commit this file. It holds op:// references only, never values:
#     NAME=op://<vault>/<item>/<field>
# Run commands with the secrets injected:
#     with-secrets -- <cmd>            (dotfiles loader, fails fast if op is
#                                       missing or signed out)
#     op run --env-file=$OP_TEMPLATE_FILE -- <cmd>
# Other environments get their own file: op/staging.env, op/prod.env
# (with-secrets -e prod -- <cmd>).

# DB_PASSWORD=op://EnvSecrets/${PROJECT_NAME}_LOCAL_SECRETS/DB_PASSWORD
# API_KEY=op://EnvSecrets/${PROJECT_NAME}_LOCAL_SECRETS/API_KEY
EOF
    success "$OP_TEMPLATE_FILE created!"
fi

# Keep real env files out of git (templates and op/*.env stay tracked)
if [[ -f .gitignore ]]; then
    # Start on a fresh line if the file does not end with a newline
    if [[ -s .gitignore && -n "$(tail -c 1 .gitignore)" ]]; then
        echo >> .gitignore
    fi
    for pattern in ".env" ".env.*" "!.env.example"; do
        if ! grep -qxF -- "$pattern" .gitignore; then
            info "Adding $pattern to .gitignore..."
            printf '%s\n' "$pattern" >> .gitignore
        fi
    done
else
    info "Creating .gitignore with .env entries..."
    cat > .gitignore << 'EOF'
# Environment variables (secrets live in 1Password; op/*.env is committed)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp
*.swo
*~
EOF
    success ".gitignore created!"
fi

echo
info "Next steps:"
echo "  1. Edit .env with non-secret local values"
echo "  2. Add secrets to 1Password and list them as op:// references in $OP_TEMPLATE_FILE"
echo "  3. Customize .envrc with project-specific configuration"
echo "  4. Run: direnv allow"
echo "  5. Run commands that need secrets with: with-secrets -- <cmd>"
echo
warn "Security reminder: never commit .env files or secret values; commit only op:// references."
