{
  "name": "local-style-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npx @biomejs/biome ci . && npx tsc --noEmit",
    "lint:fix": "npx @biomejs/biome check --fix . && npx tsc --noEmit",
    "format": "npx @biomejs/biome format --write . && npx @biomejs/biome check --fix ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
