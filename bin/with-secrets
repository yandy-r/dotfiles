#!/usr/bin/env bash
# ================================================================
# with-secrets - run a command with 1Password secrets from an env template
# ================================================================
# The loader behind the opr/ope helpers, for projects that keep their secrets
# in 1Password and commit only a template of op:// references
# (op/<env>.env, scaffolded by init-envrc). Never commit secret values.
#
#   with-secrets [-e ENV] [-f FILE]... [--no-masking] [--] COMMAND [ARGS...]
#
#   -e, --env ENV    use op/ENV.env (default: $WITH_SECRETS_ENV, then "local")
#   -f, --file FILE  use FILE as a template; repeatable; replaces the -e default
#   --no-masking     pass --no-masking to `op run` (interactive use only)
#   -h, --help       show this help
#
# Behaviour:
#   - template(s) hold op:// references -> `op run --env-file=<t>... -- COMMAND`
#   - no template, or no op:// references -> COMMAND runs as-is
#   - references but `op` missing or not signed in -> fails fast (exit 1) with
#     a hint; it never signs in for you
#
# Exit codes: COMMAND's own status, 1 for a secrets problem, 2 for bad usage.
set -euo pipefail

prog=${0##*/}

usage() {
    sed -n '/^#   with-secrets/,/^#   -h/s/^# \{0,1\}//p' "$0"
}

die() {
    printf '%s: %s\n' "$prog" "$*" >&2
    exit 1
}

usage_error() {
    printf '%s: %s\n' "$prog" "$*" >&2
    usage >&2
    exit 2
}

env_name=${WITH_SECRETS_ENV:-local}
files=()
masking=()

while (($# > 0)); do
    case $1 in
    -e | --env)
        (($# >= 2)) || usage_error "$1 needs an environment name"
        env_name=$2
        shift 2
        ;;
    -f | --file)
        (($# >= 2)) || usage_error "$1 needs a file"
        files+=("$2")
        shift 2
        ;;
    --no-masking)
        masking=(--no-masking)
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    --)
        shift
        break
        ;;
    -*) usage_error "unknown option: $1" ;;
    *) break ;;
    esac
done

(($# > 0)) || usage_error "no command given"

if ((${#files[@]} == 0)); then
    [[ $env_name =~ ^[A-Za-z0-9_.-]+$ ]] || usage_error "invalid environment name: $env_name"
    files=("op/$env_name.env")
    # The default template is optional: a project without one runs plainly.
    [[ -f ${files[0]} ]] || exec "$@"
fi

# An op:// reference is a NAME=op://... line, quoted or not, optionally
# prefixed with `export`. Comments do not count.
ref_re='^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*["'\'']?op://'

has_refs=0
for file in "${files[@]}"; do
    [[ -f $file ]] || die "env template not found: $file"
    # grep: 0 = references, 1 = none, >1 = unreadable. Never run the command
    # without its secrets because a template could not be read.
    rc=0
    grep -Eq "$ref_re" "$file" || rc=$?
    case $rc in
    0) has_refs=1 ;;
    1) ;;
    *) die "cannot read env template: $file" ;;
    esac
done

((has_refs)) || exec "$@"

command -v op >/dev/null 2>&1 ||
    die "${files[*]} references 1Password (op://) but the op CLI is not installed; run bin/install-1password-cli.sh"

op whoami >/dev/null 2>&1 ||
    die "${files[*]} references 1Password (op://) but op is not signed in; run \`op signin\` (1Password app integration) or export OP_SERVICE_ACCOUNT_TOKEN, then retry"

op_args=(run)
for file in "${files[@]}"; do
    op_args+=("--env-file=$file")
done
exec op "${op_args[@]}" ${masking[@]+"${masking[@]}"} -- "$@"
