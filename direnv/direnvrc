# Direnv configuration for cleaner output

# Override the built-in log_status function
log_status() {
    local msg="$1"
    case "$msg" in
        # Suppress the verbose export messages
        "export "*|"export"*)
            echo -e "\033[32m✓\033[0m direnv: environment loaded" >&2
            ;;
        # Show loading messages cleanly
        "loading "*|"sourcing "*)
            echo -e "\033[33m⏳\033[0m direnv: loading environment..." >&2
            ;;
        # Show unloading messages cleanly
        "unloading "*|"clearing "*)
            echo -e "\033[31m✗\033[0m direnv: environment cleared" >&2
            ;;
        *)
            # For any other messages, keep them minimal
            echo -e "\033[2mdirenv: $msg\033[0m" >&2
            ;;
    esac
}