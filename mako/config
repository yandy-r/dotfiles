anchor=top-right
layer=overlay
max-visible=5
sort=-time
default-timeout=5000
ignore-timeout=0
width=420
height=180
outer-margin=20
margin=0,0,12
padding=10,15
border-size=2
border-radius=10
icons=1
max-icon-size=48
markup=1
actions=1
history=1
format=<b>%s</b>\n%b
font=CaskaydiaMono Nerd Font 13
background-color=#181c27E6
text-color=#f5f1e8FF
border-color=#f5d88766
progress-color=over #f5d88744
group-by=app-name,summary
on-button-left=exec $HOME/.bin/mako-notification-click.sh
on-touch=exec $HOME/.bin/mako-notification-click.sh
on-button-right=dismiss

[urgency=critical]
default-timeout=0
border-color=#ef6b73CC
