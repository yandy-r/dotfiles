#!/usr/bin/env bash
# Check that every agent prompt fits the paste limit of agent CLIs
# (Claude Code's /goal accepts at most 4000 characters) with room to spare:
# prompts must stay within a 3000-character budget so at least 1000
# characters remain for context the user appends before sending.
#
# Renders agent-prompt for every profile (plus auto), task, target kind, and
# skills combination, and measures the static `replace: |` body of each
# match/prompts/*.yml (form placeholders count at their literal length, which
# is longer than any value). Also checks that the :e2e form offers exactly
# auto plus the profiles in scripts/profiles/.
#
#   check-prompt-length          # exit 1 if any check fails

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROMPTS_DIR="$SCRIPT_DIR/../match/prompts"
E2E_MATCH="$PROMPTS_DIR/agent-e2e.yml"
RENDER="$SCRIPT_DIR/agent-prompt"
LIMIT=4000           # hard paste limit (Claude Code /goal)
RESERVE=1000         # kept free for the user's own context
MAX_CHARS=$((LIMIT - RESERVE))
# Long enough to stand in for a real issue list or project name.
SAMPLE_ISSUES="YAN-723, YAN-724 and YAN-725"
SAMPLE_PROJECT="Website and commerce -- Bugs"

failures=0
worst=0
# Every prompt that merges a PR must cap bot-review fix rounds (same wording as
# BOT_REVIEW_CAP in agent-prompt). The known PR-merging prompts are required by
# name; any other prompt is required once it says "merge on green CI".
REVIEW_CAP="2 fix rounds max, then only high/P1+"
REVIEW_CAP_PROMPTS=" agent-prompt project-complete.yml project-init.yml release.yml "

check_review_cap() {
  local name="$1" text="$2" id="${3:-$1}"
  [[ "$REVIEW_CAP_PROMPTS" == *" $id "* || "$text" == *"merge on green CI"* ]] || return 0
  if [[ "$text" != *"$REVIEW_CAP"* ]]; then
    printf 'FAIL %s: merges a PR but lacks the bot-review cap (%s)\n' "$name" "$REVIEW_CAP" >&2
    failures=$((failures + 1))
  fi
}

check() {
  local name="$1" chars="$2"
  ((chars > worst)) && worst=$chars
  if ((chars > MAX_CHARS)); then
    printf 'FAIL %s: %d characters (budget %d = %d limit - %d reserved for user context)\n' \
      "$name" "$chars" "$MAX_CHARS" "$LIMIT" "$RESERVE" >&2
    failures=$((failures + 1))
  fi
}

check_renders() {
  local profile task skills target out name
  while IFS= read -r profile; do
    for task in bugs features any; do
      for target in "" "$SAMPLE_PROJECT" "$SAMPLE_ISSUES"; do
        for skills in yes no; do
          name="$profile/$task/target=${target:-none}/skills=$skills"
          # agent-prompt enforces the limit itself; any refusal is a failure.
          if ! out="$("$RENDER" --profile "$profile" --task "$task" --skills "$skills" --target "$target" 2>&1)"; then
            printf 'FAIL %s: %s\n' "$name" "$out" >&2
            failures=$((failures + 1))
            continue
          fi
          check "$name" "${#out}"
          check_review_cap "$name" "$out" agent-prompt
        done
      done
    done
  done < <(
    echo auto
    "$RENDER" --list-profiles
  )
}

# The form's profile choices must be auto plus every profile file, so adding
# or removing a profile can't silently leave the form behind.
check_form_profiles() {
  local want choices got
  want="$(
    echo auto
    "$RENDER" --list-profiles | sort
  )"
  choices="$(awk '
    /^ *profile:$/ { inprofile = 1; next }
    inprofile && /^ *values:$/ { invalues = 1; next }
    invalues && /^ *- / { sub(/^ *- */, ""); gsub(/["\047]/, ""); print; next }
    invalues { exit }
  ' "$E2E_MATCH")"
  got="$(
    head -n 1 <<<"$choices"
    tail -n +2 <<<"$choices" | sort
  )"
  if [[ "$got" != "$want" ]]; then
    printf 'FAIL %s: profile choices must be auto, then: %s\n' "${E2E_MATCH##*/}" "$("$RENDER" --list-profiles | sort | tr '\n' ' ')" >&2
    failures=$((failures + 1))
  fi
}

# Print the de-indented block scalar that follows `replace: |`.
replace_body() {
  awk '
    /^ *replace: \|/ { match($0, /^ */); indent = RLENGTH + 2; inblock = 1; next }
    inblock && /^ *[^ ]/ { match($0, /^ */); if (RLENGTH < indent) exit }
    inblock { print substr($0, indent + 1) }
  ' "$1"
}

check_static() {
  local file body
  for file in "$PROMPTS_DIR"/*.yml; do
    body="$(replace_body "$file")"
    [[ -n "$body" ]] || continue
    check "${file##*/}" "${#body}"
    check_review_cap "${file##*/}" "$body"
  done
}

check_renders
check_static
check_form_profiles
if ((failures > 0)); then
  printf '%d check(s) failed (prompt budget: %d characters)\n' "$failures" "$MAX_CHARS" >&2
  exit 1
fi
printf 'ok: every prompt fits the %d-character budget (longest: %d; >= %d free of %d)\n' \
  "$MAX_CHARS" "$worst" "$((LIMIT - worst))" "$LIMIT"
