#!/usr/bin/env bash
# shellcheck disable=SC2016 # backticks in single quotes are literal Markdown

# Render the end-to-end agent workflow prompt.
#
# Called by the espanso :e2e match, which passes its form fields as
# ESPANSO_FORM_* environment variables. Also usable directly:
#
#   agent-prompt --task bugs | wl-copy                     # any repo (auto)
#   agent-prompt --profile tokenhop --task features
#   agent-prompt --target "ITC-600, ITC-601"               # issue IDs
#   agent-prompt --target "Website redesign" --task any    # one Linear project
#
# Without a profile (or with "auto") the prompt is generic: the agent derives
# the Linear workspace, team, and projects from the repo it runs in. Optional
# profiles/<name>.conf files pin those names when the repo can't tell; see
# profiles/README.md. Target always wins over the profile.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE_DIR="${AGENT_PROMPT_PROFILES:-$SCRIPT_DIR/profiles}"

PROFILE="${ESPANSO_FORM_PROFILE:-auto}"
TASK="${ESPANSO_FORM_TASK:-bugs}"
TARGET="${ESPANSO_FORM_TARGET:-}"
SKILLS="${ESPANSO_FORM_SKILLS:-yes}"
GOAL_PREFIX="yes"
MAX_CHARS=${AGENT_PROMPT_MAX_CHARS:-4000}

ISSUE_COUNT=0

# Profile keys (overridden by the profile file). Empty or "auto" means the
# agent works the value out from the repo.
NAME=""
WORKSPACE=""
ISSUE_PREFIX=""
RELEASE_LABEL=""
POOL=""
BUGS_PROJECT=""
FEATURES_PROJECT=""
CODERABBIT="auto"
SECRETS="auto"
SECRETS_FILES=""

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Render the end-to-end agent workflow prompt to stdout.

OPTIONS:
    --profile NAME     Profile from $PROFILE_DIR, or auto (default: auto,
                       the agent derives Linear names from the repo)
    --task TASK        bugs, features, or any (default: bugs)
    --target TEXT      Issue IDs ("YAN-1, YAN-2") to work exactly those, or a
                       Linear project to pick from; overrides the profile
    --skills yes|no    Include skill hints (default: yes)
    --no-goal          Omit the leading /goal
    --list-profiles    Print the available profile names
    -h, --help         Show this help message
EOF
}

die() {
  printf 'agent-prompt: %s\n' "$*" >&2
  exit 1
}

list_profiles() {
  local f
  for f in "$PROFILE_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    f="${f##*/}"
    echo "${f%.conf}"
  done
}

# Parse KEY=value lines without executing the file. Only known keys are set;
# every key is optional.
load_profile() {
  local file="$PROFILE_DIR/$1.conf" key value
  [[ "$1" == auto ]] && return 0
  [[ "$1" =~ ^[a-z0-9-]+$ ]] || die "invalid profile name: $1"
  [[ -f "$file" ]] || die "unknown profile '$1' (available: auto $(list_profiles | tr '\n' ' '))"
  while IFS='=' read -r key value || [[ -n "$key" ]]; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    value="${value#\"}"
    value="${value%\"}"
    case "$key" in
    NAME | WORKSPACE | ISSUE_PREFIX | RELEASE_LABEL | POOL | BUGS_PROJECT | FEATURES_PROJECT | CODERABBIT | SECRETS | SECRETS_FILES)
      printf -v "$key" '%s' "$value"
      ;;
    PROJECT) die "$file: PROJECT was renamed to POOL" ;;
    *) die "$file: unknown key '$key'" ;;
    esac
  done <"$file"
  return 0
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --profile | --task | --target | --skills)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      case "$1" in
      --profile) PROFILE="$2" ;;
      --task) TASK="$2" ;;
      --target) TARGET="$2" ;;
      --skills) SKILLS="$2" ;;
      esac
      shift
      ;;
    --no-goal) GOAL_PREFIX="no" ;;
    --list-profiles)
      list_profiles
      exit 0
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die "unknown option: $1 (see --help)" ;;
    esac
    shift
  done
}


# Print ": `<skill>`" (or ": `a`, then `b`") to append to a workflow step when
# skill hints are on; print nothing when they are off.
hint() {
  [[ "$SKILLS" == "yes" ]] || return 0
  printf ': `%s`' "$1"
  [[ $# -ge 2 ]] && printf ', then `%s`' "$2"
  return 0
}

# True when --target is only issue IDs ("YAN-1", "YAN-1, YAN-2 and YAN-3");
# sets ISSUE_COUNT. Anything else is a Linear project name.
is_issue_list() {
  local words word t="${TARGET//,/ }"
  t=" $t "
  t="${t// and / }"
  read -ra words <<<"$t"
  ((${#words[@]} > 0)) || return 1
  for word in "${words[@]}"; do
    [[ "$word" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]] || return 1
  done
  ISSUE_COUNT=${#words[@]}
}

# " (<name> workspace)" when the profile pins one.
in_workspace() {
  [[ -n "$WORKSPACE" ]] && printf ' (%s workspace)' "$WORKSPACE"
  return 0
}

render_header() {
  local kind=""
  case "$TASK" in
  bugs) kind=" (bug/security fixes)" ;;
  features) kind=" (feature)" ;;
  esac
  [[ "$GOAL_PREFIX" == "yes" ]] && printf '/goal '
  printf 'Run the end-to-end research, plan, implement, test, and ship workflow%s:\n' "$kind"
}

# Explicit issues: name them and resume any work already in flight.
render_issue_scope() {
  local label="Linear issue" which="it"
  if ((ISSUE_COUNT > 1)); then
    label="Linear issues"
    which="any"
  fi
  printf -- '- %s: %s%s\n' "$label" "$TARGET" "$(in_workspace)"
  printf -- '- If %s is already done or has an open PR/branch, resume that work\n' "$which"
}

# The Linear source of the work, most specific first: a Target project, the
# profile's bugs/features project, both of them (task "any"), the profile's
# POOL ("any open X project"), else the repo's own projects. The last two name
# the kind of issue (bug/feature) since the project doesn't.
render_pick_scope() {
  local project="" kind="Linear issue" rank="Rank by priority, then value"
  case "$TASK" in
  bugs)
    project="${TARGET:-$BUGS_PROJECT}"
    kind="bug/security issue"
    rank="Rank by priority, security and data-loss bugs first"
    ;;
  features)
    project="${TARGET:-$FEATURES_PROJECT}"
    kind="feature/enhancement issue"
    ;;
  any) project="$TARGET" ;;
  esac

  if [[ -n "$project" ]]; then
    printf -- '- Pick the next best Linear issue from the open **%s** project%s\n' "$project" "$(in_workspace)"
  elif [[ "$TASK" == "any" ]] && [[ -z "$POOL" ]] && [[ -n "$BUGS_PROJECT" ]] && [[ -n "$FEATURES_PROJECT" ]]; then
    printf -- '- Pick the next best Linear issue from the open **%s** or **%s** projects%s\n' "$BUGS_PROJECT" "$FEATURES_PROJECT" "$(in_workspace)"
  else
    if [[ -n "$POOL" ]]; then
      printf -- '- Pick the next best %s from any open **%s** project%s\n' "$kind" "$POOL" "$(in_workspace)"
    else
      printf -- "- Pick the next best %s from this repo's open Linear projects%s\n" "$kind" "$(in_workspace)"
    fi
  fi
  printf '  - %s; prefer unblocked, well-specified issues\n' "$rank"
  printf '  - Skip In Progress, assigned, or open-PR/branch issues (another agent owns them)\n'
  printf -- '- Batch small related issues that share a target release into one PR\n'
}

# Where the Linear names come from. Profile names are hints that can go stale
# when a project or label is renamed, so the agent repairs rather than stops;
# naming the profile lets it catch one picked for the wrong repo.
render_linear_context() {
  if [[ -z "$WORKSPACE$POOL$BUGS_PROJECT$FEATURES_PROJECT$RELEASE_LABEL" ]]; then
    printf -- "- Linear workspace/team/projects: from RELEASING.md/AGENTS.md, else the repo name; name them in the report\n"
  else
    printf -- '- Profile for %s (other repo? stop). Name missing in Linear? Use the closest match; report it\n' "${NAME:-$PROFILE}"
  fi
}

render_scope() {
  printf '\n## Scope\n\n'
  if [[ -n "$TARGET" ]] && is_issue_list; then
    render_issue_scope
  else
    [[ "$TASK" == "issues" ]] && die "task 'issues' needs --target <issue IDs>"
    render_pick_scope
  fi
  render_linear_context
}

render_before() {
  local every="Every issue"
  if ((ISSUE_COUNT == 1)); then
    every="The issue"
  elif ((ISSUE_COUNT > 1)); then
    every="Each issue"
  fi
  cat <<'EOF'

## Before Starting

- RELEASING.md ("Where does my change go?") sets base branch, PR target, backport. Absent? Run `/ycc:release-model --yes`; commit it (with pointers) to the default branch first
- Follow CLAUDE.md/AGENTS.md (commits, PR template, labels, verification)
- Read each issue fully (comments, links, sub-issues); its acceptance criteria are the spec (none? add them first)
EOF
  if [[ -n "$RELEASE_LABEL" ]]; then
    printf -- '- %s needs a `%s` label; if missing, set it per RELEASING.md rule 1\n' "$every" "$RELEASE_LABEL"
  else
    printf -- '- %s needs a target release: a Linear release label if RELEASING.md tracker is `linear-labels` (rule 1), else state it in the PR\n' "$every"
  fi
  cat <<'EOF'
- No GitHub issue? Create and link one (check Linear attachments first)
- Move each Linear issue, and its project, to In Progress
- Others may work here: never touch changes, worktrees, or branches you didn't make
EOF
}

render_must_not() {
  cat <<'EOF'

## Must Not Do

- Docs-only: no worktree/branch; commit to the default branch
- No full test suites for non-app changes (scripts, CI)
- No sync PRs between long-lived branches, tags, releases, or CHANGELOG.md edits; change RELEASING.md only via `/ycc:release-model`
- No direct or force pushes to trunk or release branches
- Never bypass checks (`--no-verify`, skipped/deleted tests, admin merges on red CI)
- Security fixes: exploit details in Linear only, never in GitHub issues, PRs, or commits
- Blocked (no access, contradictory spec)? Stop and report what you need
EOF
}

render_workflow() {
  printf '\n## Workflow (If Coding)\n\n'
  if [[ "$SKILLS" == "yes" ]]; then
    printf 'Orchestrate with sub-agents; skills shown are hints.\n\n'
  else
    printf 'Orchestrate with sub-agents, using the appropriate skills for each step.\n\n'
  fi

  printf '1. Worktree `<area-or-type>/<issue-id>-<slug>` off the RELEASING.md base (usually trunk)\n'
  printf '2. Research%s\n' "$(hint "/ycc:feature-research <feature-name>")"
  printf '3. Design and plan%s\n' "$(hint "/ycc:prp-plan --parallel --enhanced --no-worktree <feature-spec.md>")"
  cat <<'EOF'
   - Take recommended options that favor security, UX, data integrity, performance, stability; log decisions and why in the PR
   - Ask only on irreversible or regressing choices (destructive migration, data loss, security, API break)
EOF
  printf '4. Implement%s\n' "$(hint "/ycc:prp-implement --parallel --no-worktree <plan.md>")"
  cat <<'EOF'
   - Unfinished user-reachable work: behind a RELEASING.md "Unfinished work" switch (off) or unwired; keep trunk releasable
   - Only critical tests; a bug fix starts with a failing regression test
5. Verify: lint, type-check, build, and tests covering the change
EOF
  printf '6. Adversarial review before the PR; fix findings%s\n' "$(hint "/ycc:code-review --parallel")"
  printf '7. PR to the RELEASING.md branch (`Closes %s-N`, `Closes #N`, template, labels)%s\n' \
    "${ISSUE_PREFIX:-<TEAM>}" "$(hint "/ycc:git-workflow --pr --ci --ci-yes")"
  printf '8. Review the PR, fix all findings%s\n' \
    "$(hint "/ycc:code-review --parallel <pr#>" "/ycc:pr-autofix <pr#> --parallel --severity low --yes --ci --ci-yes")"
  case "$CODERABBIT" in
  yes) printf '   - CodeRabbit: first turn only; ignore later turns once CI is green; skip if rate limited\n' ;;
  auto | "") printf '   - CodeRabbit (if present): first turn only; ignore later turns once CI is green; skip if rate limited\n' ;;
  no) ;;
  *) die "profile '$PROFILE': invalid CODERABBIT '$CODERABBIT' (expected yes, no, or auto)" ;;
  esac
  cat <<'EOF'
9. Squash merge on green CI. Unrelated CI failure: rerun once, fix if small, else stop and report; never mask it
10. Patch-line target (e.g. `v0.5.x`): label `backport:X.Y`, run `/ycc:backport <PR#> --ci`, merge the green `release/X.Y` PR
11. Remove the worktree and merged branches (local, remote); close resolved Linear and GitHub issues
12. File Linear follow-ups in the fitting projects
EOF
}

render_secrets() {
  case "$SECRETS" in
  none) return 0 ;;
  auto | "")
    printf '\n## Secrets\n\n'
    printf -- "- Use the repo's secrets tooling (dotenvx for encrypted \`.env*\`, **op** for \`op://\` refs)\n"
    ;;
  op)
    printf '\n## Secrets\n\n'
    printf -- '- Use the **op** CLI (`op read`, `op run`)\n'
    ;;
  dotenvx)
    printf '\n## Secrets\n\n'
    printf -- '- Use dotenvx (`dotenvx run`, `dotenvx get`)'
    [[ -n "$SECRETS_FILES" ]] && printf ' with the git-tracked %s files' "$SECRETS_FILES"
    printf '\n'
    ;;
  *) die "profile '$PROFILE': invalid SECRETS '$SECRETS' (expected op, dotenvx, none, or auto)" ;;
  esac
  printf -- '- Never print, log, or commit secret values\n'
}

render_done() {
  cat <<'EOF'

## Done When

- Acceptance criteria met; PR (and any backport) merged on green CI; cleanup done; issues closed
- Final report: Linear/GitHub issues, PR/backport links, target release, decisions made, follow-ups
EOF
}

main() {
  parse_args "$@"
  [[ -n "$PROFILE" ]] || PROFILE="auto"
  case "$SKILLS" in yes | no) ;; *) die "--skills must be yes or no" ;; esac
  # "project" and "issues" predate Target detection; keep them as aliases.
  case "$TASK" in
  bugs | features | any | issues) ;;
  project)
    [[ -n "$TARGET" ]] || die "task 'project' needs --target <Linear project>"
    TASK="any"
    ;;
  *) die "invalid task: $TASK (expected bugs, features, or any)" ;;
  esac
  load_profile "$PROFILE"

  # Render fully before printing so a late error never emits a partial prompt.
  local prompt
  prompt="$(
    render_header
    render_scope
    render_before
    render_must_not
    render_workflow
    render_secrets
    render_done
  )"
  # Agent CLIs cap pasted goals (Claude Code's /goal: 4000 characters).
  ((${#prompt} <= MAX_CHARS)) ||
    die "rendered prompt is ${#prompt} characters, over the ${MAX_CHARS}-character limit; shorten the template or --target"
  printf '%s\n' "$prompt"
}

main "$@"
