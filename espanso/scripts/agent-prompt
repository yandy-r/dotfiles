#!/usr/bin/env bash
# shellcheck disable=SC2016 # backticks in single quotes are literal Markdown

# Render the end-to-end agent workflow prompt for a project profile.
#
# Called by the espanso :e2e match, which passes its form fields as
# ESPANSO_FORM_* environment variables. Also usable directly:
#
#   agent-prompt --profile tokenhop --task bugs | wl-copy
#   agent-prompt --profile itcn-crm --task issues --target "ITC-600"
#
# Per-project values (workspace, Linear projects, release label, secrets) live
# in profiles/<name>.conf next to this script; see profiles/README.md.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE_DIR="${AGENT_PROMPT_PROFILES:-$SCRIPT_DIR/profiles}"

PROFILE="${ESPANSO_FORM_PROFILE:-}"
TASK="${ESPANSO_FORM_TASK:-bugs}"
TARGET="${ESPANSO_FORM_TARGET:-}"
SKILLS="${ESPANSO_FORM_SKILLS:-yes}"
GOAL_PREFIX="yes"
MAX_CHARS=4000

# Profile keys (overridden by the profile file).
NAME=""
WORKSPACE=""
ISSUE_PREFIX=""
RELEASE_LABEL=""
PROJECT=""
BUGS_PROJECT=""
FEATURES_PROJECT=""
CODERABBIT="yes"
SECRETS="none"
SECRETS_FILES=""

usage() {
  cat <<EOF
Usage: $(basename "$0") --profile NAME [OPTIONS]

Render the end-to-end agent workflow prompt to stdout.

OPTIONS:
    --profile NAME     Project profile from $PROFILE_DIR (required)
    --task TASK        bugs, features, any, project, or issues (default: bugs)
    --target TEXT      Linear project (task=project), issue IDs (task=issues),
                       or an override for the profile's default project
    --skills yes|no    Include skill hints (default: yes)
    --no-goal          Omit the leading /goal
    --list-profiles    Print the available profile names
    -h, --help         Show this help message
EOF
}

die() {
  printf 'agent-prompt: %s\n' "$*" >&2
  exit 1
}

list_profiles() {
  local f
  for f in "$PROFILE_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    f="${f##*/}"
    echo "${f%.conf}"
  done
}

# Parse KEY=value lines without executing the file. Only known keys are set.
load_profile() {
  local file="$PROFILE_DIR/$1.conf" key value
  [[ "$1" =~ ^[a-z0-9-]+$ ]] || die "invalid profile name: $1"
  [[ -f "$file" ]] || die "unknown profile '$1' (available: $(list_profiles | tr '\n' ' '))"
  while IFS='=' read -r key value || [[ -n "$key" ]]; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    value="${value#\"}"
    value="${value%\"}"
    case "$key" in
    NAME | WORKSPACE | ISSUE_PREFIX | RELEASE_LABEL | PROJECT | BUGS_PROJECT | FEATURES_PROJECT | CODERABBIT | SECRETS | SECRETS_FILES)
      printf -v "$key" '%s' "$value"
      ;;
    *) die "$file: unknown key '$key'" ;;
    esac
  done <"$file"
  [[ -n "$WORKSPACE" ]] || die "$file: WORKSPACE is required"
  [[ -n "$ISSUE_PREFIX" ]] || die "$file: ISSUE_PREFIX is required"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --profile | --task | --target | --skills)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      case "$1" in
      --profile) PROFILE="$2" ;;
      --task) TASK="$2" ;;
      --target) TARGET="$2" ;;
      --skills) SKILLS="$2" ;;
      esac
      shift
      ;;
    --no-goal) GOAL_PREFIX="no" ;;
    --list-profiles)
      list_profiles
      exit 0
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die "unknown option: $1 (see --help)" ;;
    esac
    shift
  done
}


# Print ": `<skill>`" (or ": `a`, then `b`") to append to a workflow step when
# skill hints are on; print nothing when they are off.
hint() {
  [[ "$SKILLS" == "yes" ]] || return 0
  printf ': `%s`' "$1"
  [[ $# -ge 2 ]] && printf ', then `%s`' "$2"
  return 0
}

# True when --target lists more than one issue ("YAN-1 and YAN-2", "YAN-1, YAN-2").
multiple_issues() {
  [[ "$TARGET" =~ [[:space:],] ]]
}

render_header() {
  local kind=""
  case "$TASK" in
  bugs) kind=" (bug/security fixes)" ;;
  features) kind=" (feature)" ;;
  esac
  [[ "$GOAL_PREFIX" == "yes" ]] && printf '/goal '
  printf 'Run the full end-to-end research, design, plan, implement, and test workflow%s:\n' "$kind"
}

# Explicit issues: name them and resume any work already in flight.
render_issue_scope() {
  local label="Linear issue" which="it"
  if multiple_issues; then
    label="Linear issues"
    which="any"
  fi
  printf -- '- %s: %s (%s workspace)\n' "$label" "$TARGET" "$WORKSPACE"
  printf -- '- If %s is already done or has an open PR/branch, resume that work\n' "$which"
}

# The Linear source of the work. A dedicated bugs/features project is named
# directly; falling back to the profile's PROJECT pool ("any open X project")
# adds a focus line instead. Task "any" without a pool spans the profile's bugs
# and features projects.
render_pick_scope() {
  local project="" focus="" rank="Rank by priority, then value and readiness"
  case "$TASK" in
  bugs)
    project="${TARGET:-$BUGS_PROJECT}"
    focus="Focus on bug and security issues"
    rank="Rank by priority, security and data-loss bugs first"
    ;;
  features)
    project="${TARGET:-$FEATURES_PROJECT}"
    focus="Focus on new features and enhancements"
    ;;
  any | project) project="$TARGET" ;;
  esac
  [[ "$TASK" == "project" ]] && [[ -z "$TARGET" ]] && die "task 'project' needs --target <Linear project>"

  if [[ -n "$project" ]]; then
    printf -- '- Pick the next best Linear issue from the open **%s** project (%s workspace)\n' "$project" "$WORKSPACE"
  elif [[ "$TASK" == "any" ]] && [[ -z "$PROJECT" ]] && [[ -n "$BUGS_PROJECT" ]] && [[ -n "$FEATURES_PROJECT" ]]; then
    printf -- '- Pick the next best Linear issue from the open **%s** or **%s** projects (%s workspace)\n' "$BUGS_PROJECT" "$FEATURES_PROJECT" "$WORKSPACE"
  else
    [[ -n "$PROJECT" ]] || die "profile '$PROFILE' has no default project for task '$TASK' - pass --target"
    printf -- '- Pick the next best Linear issue from any open **%s** project (%s workspace)\n' "$PROJECT" "$WORKSPACE"
    [[ -n "$focus" ]] && printf '  - %s\n' "$focus"
  fi
  printf '  - %s; prefer unblocked, well-specified issues\n' "$rank"
  printf '  - Skip In Progress, assigned, or open-PR/branch issues (another agent may own them)\n'
  printf -- '- Batch related or small issues into one PR if they share a target release\n'
}

render_scope() {
  printf '\n## Scope\n\n'
  case "$TASK" in
  issues)
    [[ -n "$TARGET" ]] || die "task 'issues' needs --target <issue IDs>"
    render_issue_scope
    ;;
  bugs | features | any | project) render_pick_scope ;;
  *) die "invalid task: $TASK (expected bugs, features, any, project, or issues)" ;;
  esac
}

render_before() {
  local every="Every issue"
  if [[ "$TASK" == "issues" ]]; then
    every="The issue"
    multiple_issues && every="Each issue"
  fi
  cat <<'EOF'

## Before Starting

- Read RELEASING.md ("Current state", "Where does my change go?"): it sets base branch, PR target, backport. If absent, run `/ycc:release-model --yes` and commit it (with its pointers) to the default branch first
- Follow CLAUDE.md/AGENTS.md (commits, PR template, labels, verification)
EOF
  if [[ -n "$RELEASE_LABEL" ]]; then
    printf -- '- %s needs a `%s` label; if missing, set it per RELEASING.md rule 1\n' "$every" "$RELEASE_LABEL"
  else
    printf -- '- %s needs a target release: its Linear release label if RELEASING.md tracker is `linear-labels` (set per rule 1), else state it in the PR\n' "$every"
  fi
  cat <<'EOF'
- No GitHub issue? Create and link one (check Linear attachments first)
- Move each Linear issue, and its project, to In Progress
- Others may work here too: never touch changes, worktrees, or branches you didn't make
EOF
}

render_must_not() {
  cat <<'EOF'

## Must Not Do

- Docs-only tasks: no worktree/branch; commit to the default branch
- No full test suites for non-app changes (scripts, CI)
- No sync PRs between long-lived branches, tags, releases, or CHANGELOG.md edits; change RELEASING.md only via `/ycc:release-model`
- No direct or force pushes to the trunk or release branches
- Never bypass checks (`--no-verify`, skipped/deleted tests, admin merges on red CI)
- Security fixes: exploit details go in Linear only, never in GitHub issues, PRs, or commits
EOF
}

render_workflow() {
  printf '\n## Workflow (If Coding)\n\n'
  if [[ "$SKILLS" == "yes" ]]; then
    printf 'Orchestrate with sub-agents. Skills shown are hints; use any that help.\n\n'
  else
    printf 'Orchestrate with sub-agents, using the appropriate skills for each step.\n\n'
  fi

  printf '1. Worktree `<area-or-type>/<issue-id>-<slug>` off the RELEASING.md base (usually trunk)\n'
  printf '2. Research%s\n' "$(hint "/ycc:feature-research <feature-name>")"
  printf '3. Design and plan%s\n' "$(hint "/ycc:prp-plan --parallel --enhanced --no-worktree <feature-spec.md>")"
  cat <<'EOF'
   - Take recommended options that uphold security, UI/UX, data integrity, performance, stability; log decisions and reasons in the PR
   - Ask only on irreversible or regressing choices (destructive migration, data loss, security, public API break)
EOF
  printf '4. Implement%s\n' "$(hint "/ycc:prp-implement --parallel --no-worktree <plan.md>")"
  cat <<'EOF'
   - Gate user-reachable unfinished work behind a RELEASING.md "Unfinished work" switch (off) or leave it unwired; keep trunk releasable
   - Only critical/required tests (a bug fix needs a regression test)
5. Verify: lint, type-check, build, and tests covering the change
EOF
  printf '6. Adversarial review before the PR; fix findings%s\n' "$(hint "/ycc:code-review --parallel")"
  printf '7. PR into the RELEASING.md branch with `Closes %s-N` and `Closes #N`, per template and labels%s\n' \
    "$ISSUE_PREFIX" "$(hint "/ycc:git-workflow --pr --ci --ci-yes")"
  printf '8. Review the PR, fix all findings%s\n' \
    "$(hint "/ycc:code-review --parallel <pr#>" "/ycc:pr-autofix <pr#> --parallel --severity low --yes --ci --ci-yes")"
  if [[ "$CODERABBIT" == "yes" ]]; then
    printf '   - CodeRabbit: first turn only; ignore later turns once CI is green; skip if rate limited\n'
  fi
  cat <<'EOF'
9. Squash merge on green CI. Unrelated CI failure: rerun once, fix if small, else stop and report; never mask it
10. Patch-line target (e.g. `v0.5.x`): label `backport:X.Y`, run `/ycc:backport <PR#> --ci`, get the `release/X.Y` PR green and merged
11. Remove the worktree and merged branches (local, remote); close resolved Linear issues; confirm the GitHub issue closed
12. File Linear follow-ups in fitting projects (create one if none fits)
EOF
}

render_secrets() {
  case "$SECRETS" in
  none | "") return 0 ;;
  op)
    printf '\n## Secrets\n\n'
    printf -- '- Use the **op** CLI (`op read`, `op run`)\n'
    ;;
  dotenvx)
    printf '\n## Secrets\n\n'
    printf -- '- Always use dotenvx (`dotenvx run`, `dotenvx get`)'
    [[ -n "$SECRETS_FILES" ]] && printf '; look for git-tracked %s files' "$SECRETS_FILES"
    printf '\n'
    ;;
  *) die "profile '$PROFILE': invalid SECRETS '$SECRETS' (expected op, dotenvx, or none)" ;;
  esac
  printf -- '- Never print, log, or commit secret values\n'
}

render_done() {
  cat <<'EOF'

## Done When

- Every step is done: PR (and any backport) merged on green CI, cleanup finished, Linear issues closed
- Final report: Linear/GitHub issues, PR/backport links, target release, decisions made for me, follow-ups
EOF
}

main() {
  parse_args "$@"
  [[ -n "$PROFILE" ]] || die "--profile is required (available: $(list_profiles | tr '\n' ' '))"
  case "$SKILLS" in yes | no) ;; *) die "--skills must be yes or no" ;; esac
  load_profile "$PROFILE"

  # Render fully before printing so a late error never emits a partial prompt.
  local prompt
  prompt="$(
    render_header
    render_scope
    render_before
    render_must_not
    render_workflow
    render_secrets
    render_done
  )"
  # Agent CLIs cap pasted goals (Claude Code's /goal: 4000 characters).
  ((${#prompt} <= MAX_CHARS)) ||
    die "rendered prompt is ${#prompt} characters, over the ${MAX_CHARS}-character limit; shorten the template or --target"
  printf '%s\n' "$prompt"
}

main "$@"
