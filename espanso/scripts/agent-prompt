#!/usr/bin/env bash
# shellcheck disable=SC2016 # backticks in single quotes are literal Markdown

# Render the end-to-end agent workflow prompt.
#
# Called by the espanso :e2e match, which passes its form fields as
# ESPANSO_FORM_* environment variables. Also usable directly:
#
#   agent-prompt --task bugs | wl-copy                     # any repo (auto)
#   agent-prompt --profile tokenhop --task features
#   agent-prompt --target "ITC-600, ITC-601"               # issue IDs
#   agent-prompt --target "Website redesign" --task any    # one Linear project
#
# Without a profile (or with "auto") the prompt is generic: the agent uses the
# itcn workspace and derives the Linear team and projects from the repo it runs
# in. Optional profiles/<name>.conf files pin those names when the repo can't
# tell; see profiles/README.md. Target always wins over the profile.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE_DIR="${AGENT_PROMPT_PROFILES:-$SCRIPT_DIR/profiles}"

PROFILE="${ESPANSO_FORM_PROFILE:-auto}"
TASK="${ESPANSO_FORM_TASK:-bugs}"
TARGET="${ESPANSO_FORM_TARGET:-}"
SKILLS="${ESPANSO_FORM_SKILLS:-yes}"
GOAL_PREFIX="yes"
MAX_CHARS=${AGENT_PROMPT_MAX_CHARS:-4000}
# Bot reviewers (CodeRabbit, Codex, Claude, Greptile, ...) can comment forever;
# cap the fix loop. Keep in sync with match/prompts/*.yml (check-prompt-length).
BOT_REVIEW_CAP='Bots (CodeRabbit/Codex/Claude/Greptile/...): 2 fix rounds max, then only high/P1+; reply to rest'

ISSUE_COUNT=0

# Profile keys (overridden by the profile file). Empty or "auto" means the
# agent works the value out from the repo.
NAME=""
WORKSPACE=""
TEAM=""
ISSUE_PREFIX=""
RELEASE_LABEL=""
POOL=""
BUGS_PROJECT=""
FEATURES_PROJECT=""
CODEX="auto"
SECRETS="auto"
SECRETS_FILES=""

usage() {
	cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Render the end-to-end agent workflow prompt to stdout.

OPTIONS:
    --profile NAME     Profile from $PROFILE_DIR, or auto (default: auto,
                       use itcn workspace; derive team/projects from the repo)
    --task TASK        bugs, features, or any (default: bugs)
    --target TEXT      Issue IDs ("YAN-1, YAN-2") to work exactly those, or a
                       Linear project to pick from; overrides the profile
    --skills yes|no    Include skill hints (default: yes)
    --no-goal          Omit the leading /goal
    --list-profiles    Print the available profile names
    -h, --help         Show this help message
EOF
}

die() {
	printf 'agent-prompt: %s\n' "$*" >&2
	exit 1
}

list_profiles() {
	local f
	for f in "$PROFILE_DIR"/*.conf; do
		[[ -e "$f" ]] || continue
		f="${f##*/}"
		echo "${f%.conf}"
	done
}

# Parse KEY=value lines without executing the file. Only known keys are set;
# every key is optional.
load_profile() {
	local file="$PROFILE_DIR/$1.conf" key value
	[[ "$1" == auto ]] && return 0
	[[ "$1" =~ ^[a-z0-9-]+$ ]] || die "invalid profile name: $1"
	[[ -f "$file" ]] || die "unknown profile '$1' (available: auto $(list_profiles | tr '\n' ' '))"
	while IFS='=' read -r key value || [[ -n "$key" ]]; do
		[[ -z "$key" || "$key" == \#* ]] && continue
		value="${value#\"}"
		value="${value%\"}"
		case "$key" in
		NAME | WORKSPACE | TEAM | ISSUE_PREFIX | RELEASE_LABEL | POOL | BUGS_PROJECT | FEATURES_PROJECT | CODEX | SECRETS | SECRETS_FILES)
			printf -v "$key" '%s' "$value"
			;;
		PROJECT) die "$file: PROJECT was renamed to POOL" ;;
		CODERABBIT) die "$file: CODERABBIT was replaced by CODEX" ;;
		*) die "$file: unknown key '$key'" ;;
		esac
	done <"$file"
	return 0
}

parse_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--profile | --task | --target | --skills)
			[[ $# -ge 2 ]] || die "$1 requires a value"
			case "$1" in
			--profile) PROFILE="$2" ;;
			--task) TASK="$2" ;;
			--target) TARGET="$2" ;;
			--skills) SKILLS="$2" ;;
			esac
			shift
			;;
		--no-goal) GOAL_PREFIX="no" ;;
		--list-profiles)
			list_profiles
			exit 0
			;;
		-h | --help)
			usage
			exit 0
			;;
		*) die "unknown option: $1 (see --help)" ;;
		esac
		shift
	done
}

# Print ": `<skill>`" (or ": `a`, then `b`") to append to a workflow step when
# skill hints are on; print nothing when they are off.
hint() {
	[[ "$SKILLS" == "yes" ]] || return 0
	printf ': `%s`' "$1"
	[[ $# -ge 2 ]] && printf ', then `%s`' "$2"
	return 0
}

# True when --target is only issue IDs ("YAN-1", "YAN-1, YAN-2 and YAN-3");
# sets ISSUE_COUNT. Anything else is a Linear project name.
is_issue_list() {
	local words word t="${TARGET//,/ }"
	t=" $t "
	t="${t// and / }"
	read -ra words <<<"$t"
	((${#words[@]} > 0)) || return 1
	for word in "${words[@]}"; do
		[[ "$word" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]] || return 1
	done
	ISSUE_COUNT=${#words[@]}
}

# " (<workspace> workspace, <team> team)" for names pinned by the profile.
linear_location() {
	local location=""
	[[ -n "$WORKSPACE" ]] && location="$WORKSPACE workspace"
	if [[ -n "$TEAM" ]]; then
		[[ -n "$location" ]] && location+=", "
		location+="$TEAM team"
	fi
	[[ -n "$location" ]] && printf ' (%s)' "$location"
	return 0
}

render_header() {
	local kind=""
	case "$TASK" in
	bugs) kind=" (bug/security fixes)" ;;
	features) kind=" (feature)" ;;
	esac
	[[ "$GOAL_PREFIX" == "yes" ]] && printf '/goal '
	printf 'E2E%s: research→plan→implement→test→ship.\n' "$kind"
}

# Explicit issues: name them and resume any work already in flight.
render_issue_scope() {
	local label="Linear issue" which="it"
	if ((ISSUE_COUNT > 1)); then
		label="Linear issues"
		which="any"
	fi
	printf -- '- %s: %s%s\n' "$label" "$TARGET" "$(linear_location)"
	printf -- '- %s done or has open PR/branch? Resume if yours, else skip\n' "${which^}"
}

# The Linear source of the work, most specific first: a Target project, the
# profile's bugs/features project, both of them (task "any"), the profile's
# POOL ("any open X project"), else the repo's own projects. The last two name
# the kind of issue (bug/feature) since the project doesn't.
render_pick_scope() {
	local project="" kind="Linear issue" rank="Rank: milestone, priority, then value"
	case "$TASK" in
	bugs)
		project="${TARGET:-$BUGS_PROJECT}"
		kind="bug/security issue"
		rank="Rank: milestone, priority; security/data-loss first"
		;;
	features)
		project="${TARGET:-$FEATURES_PROJECT}"
		kind="feature/enhancement issue"
		;;
	any) project="$TARGET" ;;
	esac

	if [[ -n "$project" ]]; then
		printf -- '- Next best issue in open Linear project **%s**%s\n' "$project" "$(linear_location)"
	elif [[ "$TASK" == "any" ]] && [[ -z "$POOL" ]] && [[ -n "$BUGS_PROJECT" ]] && [[ -n "$FEATURES_PROJECT" ]]; then
		printf -- '- Next best issue in open Linear projects **%s**/**%s**%s\n' "$BUGS_PROJECT" "$FEATURES_PROJECT" "$(linear_location)"
	else
		if [[ -n "$POOL" ]]; then
			printf -- '- Next best %s in any open **%s** project%s\n' "$kind" "$POOL" "$(linear_location)"
		else
			printf -- "- Next best %s in repo's open Linear projects%s\n" "$kind" "$(linear_location)"
		fi
	fi
	printf '  - %s; prefer unblocked, well-specified\n' "$rank"
	printf '  - Skip In Progress/assigned/with PR or branch\n'
	printf -- '- Small related issues, same target release → one PR\n'
}

# Where the Linear names come from. Profile names are hints that can go stale
# when a project or label is renamed, so the agent repairs rather than stops;
# naming the profile lets it catch one picked for the wrong repo.
render_linear_context() {
	if [[ -z "$WORKSPACE$TEAM$POOL$BUGS_PROJECT$FEATURES_PROJECT$RELEASE_LABEL" ]]; then
		printf -- "- Linear: itcn workspace; team (itcn|yandy-r) + projects from RELEASING.md/AGENTS.md or repo name; report them\n"
	else
		printf -- '- Profile for %s (other repo? stop). Name missing? Closest match, report it\n' "${NAME:-$PROFILE}"
	fi
}

render_scope() {
	printf '\n## Scope\n\n'
	if [[ -n "$TARGET" ]] && is_issue_list; then
		render_issue_scope
	else
		[[ "$TASK" == "issues" ]] && die "task 'issues' needs --target <issue IDs>"
		render_pick_scope
	fi
	render_linear_context
}

render_before() {
	local every="Every issue"
	if ((ISSUE_COUNT == 1)); then
		every="Issue"
	elif ((ISSUE_COUNT > 1)); then
		every="Each issue"
	fi
	cat <<'EOF'

## Before

- RELEASING.md → base branch, PR target, backport. Missing? `/ycc:release-model --yes` on own branch, PR it first
- Obey CLAUDE.md/AGENTS.md
- Read issues fully (comments, links, subs); acceptance criteria = spec (none? write)
EOF
	if [[ -n "$RELEASE_LABEL" ]]; then
		printf -- '- %s needs `%s` label (RELEASING.md rule 1)\n' "$every" "$RELEASE_LABEL"
	else
		printf -- '- %s needs target release: Linear label if RELEASING.md tracker `linear-labels`, else in PR\n' "$every"
	fi
	cat <<'EOF'
- Link GitHub issue (Linear attachments; else create)
- Issues + project → In Progress
EOF
}

render_must_not() {
	cat <<'EOF'

## Never

- Touch others' changes/worktrees/branches
- Full test suites for non-app changes
- Long-lived-branch sync PRs; tags/releases/CHANGELOG.md; RELEASING.md edits outside `/ycc:release-model`
- Direct commit/push to default/release/long-lived branches (docs too)
- Bypass checks (`--no-verify`, skipped/deleted tests, admin merge on red CI)
- Exploit details outside Linear
- Guess when blocked (no access, bad spec): stop, report needs
EOF
}

render_workflow() {
	if [[ "$SKILLS" == "yes" ]]; then
		printf '\n## Workflow (if coding; sub-agents, skills = hints)\n\n'
	else
		printf '\n## Workflow (if coding; sub-agents + fitting skills)\n\n'
	fi

	printf '1. Worktree `<type>/<issue-id>-<slug>` off RELEASING.md base\n'
	printf '2. Research%s\n' "$(hint "/ycc:feature-research")"
	printf '3. Plan%s\n' "$(hint "/ycc:prp-plan --parallel --enhanced --no-worktree")"
	cat <<'EOF'
   - Favor security/UX/data integrity/perf/stability; log decisions+why in PR
   - Ask only if irreversible (destructive migration, data loss, security, API break)
EOF
	printf '4. Implement%s\n' "$(hint "/ycc:prp-implement --parallel --no-worktree")"
	cat <<'EOF'
   - Unfinished user-reachable work: off behind RELEASING.md switch or unwired
   - Critical tests only; bug fix: failing regression test first
5. Verify: lint, type-check, build, tests for change
EOF
	printf '6. Adversarial review, fix%s\n' "$(hint "/ycc:code-review --parallel")"
	printf '7. PR (`Closes %s-N`, `Closes #N`, template, labels)%s\n' \
		"${ISSUE_PREFIX:-<TEAM>}" "$(hint "/ycc:git-workflow --pr --ci --ci-yes")"
	printf '8. Review PR, fix%s\n' \
		"$(hint "/ycc:code-review --parallel <pr#>" "/ycc:pr-autofix <pr#> --parallel --severity low --yes --ci --ci-yes")"
	printf '   - %s' "$BOT_REVIEW_CAP"
	case "$CODEX" in
	yes) printf '; one `@codex review`, skip if limited' ;;
	auto | "") printf '; Codex (if present): one `@codex review`' ;;
	no) ;;
	*) die "profile '$PROFILE': invalid CODEX '$CODEX' (expected yes, no, or auto)" ;;
	esac
	printf '\n'
	cat <<'EOF'
9. Squash merge on green CI. Unrelated CI fail: rerun once, fix if small, else stop, report; never mask
10. Patch-line target (`vX.Y.x`): label `backport:X.Y`, `/ycc:backport <PR#> --ci`, merge its green PR
11. Remove worktree + merged branches (local+remote); close Linear + GitHub issues; file Linear follow-ups
EOF
}

render_secrets() {
	case "$SECRETS" in
	none) return 0 ;;
	auto | "")
		printf '\n## Secrets\n\n'
		printf -- "- Repo tooling (dotenvx: encrypted \`.env*\`; op: \`op://\` refs)\n"
		;;
	op)
		printf '\n## Secrets\n\n'
		printf -- '- **op** CLI (`op read`, `op run`)\n'
		;;
	dotenvx)
		printf '\n## Secrets\n\n'
		printf -- '- dotenvx (`dotenvx run`, `dotenvx get`)'
		[[ -n "$SECRETS_FILES" ]] && printf ' w/ git-tracked %s' "$SECRETS_FILES"
		printf '\n'
		;;
	*) die "profile '$PROFILE': invalid SECRETS '$SECRETS' (expected op, dotenvx, none, or auto)" ;;
	esac
	printf -- '- Never print/log/commit secret values\n'
}

render_done() {
	cat <<'EOF'

## Done When

- Criteria met; PR (+ backport) merged green; cleanup done; issues closed
- Report: issues, PR/backport links, target release, decisions, follow-ups
EOF
}

main() {
	parse_args "$@"
	[[ -n "$PROFILE" ]] || PROFILE="auto"
	case "$SKILLS" in yes | no) ;; *) die "--skills must be yes or no" ;; esac
	# "project" and "issues" predate Target detection; keep them as aliases.
	case "$TASK" in
	bugs | features | any | issues) ;;
	project)
		[[ -n "$TARGET" ]] || die "task 'project' needs --target <Linear project>"
		TASK="any"
		;;
	*) die "invalid task: $TASK (expected bugs, features, or any)" ;;
	esac
	load_profile "$PROFILE"

	# Render fully before printing so a late error never emits a partial prompt.
	local prompt
	prompt="$(
		render_header
		render_scope
		render_before
		render_must_not
		render_workflow
		render_secrets
		render_done
	)"
	# Agent CLIs cap pasted goals (Claude Code's /goal: 4000 characters).
	((${#prompt} <= MAX_CHARS)) ||
		die "rendered prompt is ${#prompt} characters, over the ${MAX_CHARS}-character limit; shorten the template or --target"
	printf '%s\n' "$prompt"
}

main "$@"
